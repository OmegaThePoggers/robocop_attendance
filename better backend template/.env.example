# Application
APP_NAME="AI Attendance System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/attendance_db

# JWT
SECRET_KEY=change-me-use-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO / S3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=attendance-images
S3_REGION=us-east-1

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# AI thresholds
FACE_CONFIDENCE_CONFIRMED=0.60
FACE_CONFIDENCE_UNCERTAIN=0.45
MIN_FACE_SIZE_PX=80
MAX_IMAGE_WIDTH=1280
